# ─── Server (Vercel + local) ───────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# MongoDB Atlas connection string
DB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Production site URL (no trailing slash) — used for CORS + invite emails
CLIENT_URL=https://your-app.vercel.app

# ─── Clerk (https://dashboard.clerk.com) ───────────────────────────────────
CLERK_SECRET_KEY=sk_live_or_sk_test_...
CLERK_PUBLISHABLE_KEY=pk_live_or_pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_or_pk_test_...

# ─── Stream Chat + Video (https://dashboard.getstream.io) ──────────────────
STREAM_API_KEY=
STREAM_API_SECRET=
VITE_STREAM_API_KEY=

# ─── Frontend API (production: leave empty or /api — uses same domain) ─────
# VITE_API_URL=/api
# Local dev backend (optional):
# VITE_BACKEND_URL=http://127.0.0.1:4000

# ─── Admin ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=your-admin@gmail.com

# ─── Email invites (Gmail app password) ────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ─── AI (optional) ─────────────────────────────────────────────────────────
CLAUDE_API_KEY=
GEMINI_API_KEY=

# ─── Inngest (optional — user sync webhooks) ───────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
