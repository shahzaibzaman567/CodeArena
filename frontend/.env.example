# ============================================
# CodeArena Frontend Environment Variables
# ============================================

# Backend API URL (required)
# For local development:
VITE_API_URL=http://localhost:4000

# For production (replace with your actual deployed backend URL):
# VITE_API_URL=https://code-arena-backend.vercel.app

# Clerk Publishable Key (required for authentication)
# Development key starts with pk_test_ — shows a warning in production
# Production key starts with pk_live_ — get it from https://dashboard.clerk.com
# For Vercel deployment: set VITE_CLERK_PUBLISHABLE_KEY in Vercel Environment Variables
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Stream Video API Key (required for video calls)
# Get this from your Stream dashboard: https://dashboard.getstream.io
VITE_STREAM_API_KEY=your_stream_api_key_here

